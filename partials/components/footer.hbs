<footer class="gh-footer{{#match @custom.header_and_footer_color "Accent color"}} has-accent-color{{/match}} gh-outer">
    <div class="gh-footer-inner gh-inner">

        {{#if @site.members_enabled}}
            {{#unless @member}}
                <section class="gh-footer-signup">
                    <h2 class="gh-footer-signup-header is-title">
                        {{#if @custom.signup_heading}}{{@custom.signup_heading}}{{else}}{{@site.title}}{{/if}}
                    </h2>
                    <p class="gh-footer-signup-subhead is-body">
                        {{#if @custom.signup_subheading}}{{@custom.signup_subheading}}{{else}}{{@site.description}}{{/if}}
                    </p>
                    {{> "email-subscription" email_field_id="footer-email"}}
                </section>
            {{/unless}}
        {{/if}}

        <div class="gh-social-links">
            {{#social_accounts @site}}
                <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                    {{#> (concat "icons/" type)}}
                        {{!-- Fallback rendered when no per-platform icon partial exists --}}
                        <span>{{name}}</span>
                    {{/undefined}}
                </a>
            {{/social_accounts}}
            {{!-- GitHub isn't a Ghost-core social account, so it's wired via a custom theme setting --}}
            {{#if @custom.github_url}}
                <a href="{{@custom.github_url}}" target="_blank" rel="noopener" aria-label="GitHub">
                    {{> "icons/github"}}
                </a>
            {{/if}}
        </div>
        {{!--
            Ghost core emits the built-in socials in a fixed canonical order and
            can't interleave bespoke ones (e.g. GitHub). Sort the whole set
            alphabetically by label at parse time — before first paint, so no
            flash — with no per-social config, so any social added later sorts
            itself. Degrades gracefully: with JS off the links still render.
        --}}
        <script>
            (function () {
                var box = document.currentScript.previousElementSibling;
                if (!box) return;
                Array.prototype.slice.call(box.children)
                    .sort(function (a, b) {
                        return (a.getAttribute('aria-label') || '').localeCompare(
                            b.getAttribute('aria-label') || '', undefined, {sensitivity: 'base'}
                        );
                    })
                    .forEach(function (el) { box.appendChild(el); });
            })();
        </script>

        <div class="gh-footer-bar">
            <span class="gh-footer-logo is-title">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </span>
            <nav class="gh-footer-menu">
                {{navigation type="secondary"}}
            </nav>
            <div class="gh-footer-copyright">
                {{{t "Powered by {ghostlink}" ghostlink="<a href=\"https://ghost.org/\" target=\"_blank\" rel=\"noopener\">Ghost</a>"}}}
            </div>
        </div>

    </div>
</footer>
